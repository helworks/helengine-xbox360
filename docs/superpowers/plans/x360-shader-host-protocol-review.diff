+        self.assertEqual((resources["sampler"]["set"], resources["sampler"]["binding"]), (0, 0))
+        self.assertEqual(result["metadata"]["textures"][0]["fetch_constant"], 1)
+
+    def test_includes_use_the_live_protocol_and_hash_supplied_contents(self):
