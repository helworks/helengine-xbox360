+    79: "VectorShuffle", 80: "CompositeConstruct", 81: "CompositeExtract",
+    82: "CompositeInsert", 83: "CopyObject", 86: "SampledImage",
+    87: "ImageSampleImplicitLod", 88: "ImageSampleExplicitLod",
