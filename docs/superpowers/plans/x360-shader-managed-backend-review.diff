+        Assert.Equal("PSShade", result.ProgramDefinition.EntryPoint);
+        Assert.Equal("textured-variant", result.Binary.Variant);
+        Assert.Equal(new byte[] { 0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef }, result.Binary.Bytecode);
