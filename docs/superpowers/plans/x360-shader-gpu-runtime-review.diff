+};
+static const uint32_t hel_probe_vs_constants[] = {
+#ifdef HEL_TEST_ZERO_CONSTANTS
+    0u
+#else
+    0x3F800000u, 0xC0200000u
+#endif
+};
+static const uint32_t hel_probe_ps_constants[] = {
