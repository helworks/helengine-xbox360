<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EditorPublishRoot Condition="'$(EditorPublishRoot)' == ''">$(MSBuildThisFileDirectory)../../.artifacts/cube-test-shared/editor</EditorPublishRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="helengine.editor"><HintPath>$(EditorPublishRoot)/helengine.editor.dll</HintPath></Reference>
    <Reference Include="helengine.core"><HintPath>$(EditorPublishRoot)/helengine.core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
